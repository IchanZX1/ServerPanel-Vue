# ── Server ──
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── JWT RS256 ──
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Database MySQL 8.0+ ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=panel_server_v2
DB_CONNECTION_LIMIT=10

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── SMTP (Nodemailer) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZXcoderID <no-reply@example.com>"

# ── Pterodactyl Application API ──
PTERO_BASE_URL=https://panel.example.com
PTERO_API_KEY=
PTERO_NODE_ID=1
PTERO_EGG_ID=15
PTERO_NEST_ID=5
PTERO_LOCATION_ID=1
PTERO_DOCKER_IMAGE=ghcr.io/parkervcp/yolks:nodejs_22

# ── Sociabuzz / Maelyn Payment ──
MAELYN_API_KEY=
MAELYN_BASE_URL=https://api.maelyn.eu/api

# ── Encryption (AES-256-GCM) — 64 hex chars ──
ENCRYPTION_KEY=

# ── Cloudflare Turnstile ──
TURNSTILE_SECRET_KEY=

# ── Admin seed ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# ── Session ──
SESSION_SECRET=ubah-minimal-32-karakter-sesuai-keinginan-kamu-123456
